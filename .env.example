# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it is already in .gitignore.
# ============================================================

# --- Option A: Groq (recommended free tier) ---
# Sign up free at https://console.groq.com/keys
# Free: 8,000 tokens/min · 1,000 requests/day · no credit card
T2SQL_LLM_PROVIDER=groq
T2SQL_LLM_MODEL=qwen/qwen3.8-27b
T2SQL_LLM_API_KEY=your_groq_api_key_here

# --- Option B: Google Gemini (free via AI Studio) ---
# Sign up free at https://aistudio.google.com/apikey
# Free: 1M tokens/day on gemini-2.0-flash
# T2SQL_LLM_PROVIDER=gemini
# T2SQL_LLM_MODEL=gemini-2.0-flash
# T2SQL_LLM_API_KEY=your_gemini_api_key_here

# --- Option C: OpenAI ---
# T2SQL_LLM_PROVIDER=openai
# T2SQL_LLM_MODEL=gpt-4o-mini
# T2SQL_LLM_API_KEY=your_openai_api_key_here

# --- Option D: Local Ollama ---
# Install from https://ollama.com · run: ollama pull qwen2.5-coder:7b
# T2SQL_LLM_BASE_URL=http://localhost:11434/v1
# T2SQL_LLM_MODEL=qwen2.5-coder:7b
# T2SQL_LLM_API_KEY=ollama

# --- Optional settings ---
# Protect /v1/* endpoints with an API key (comma-separated)
# T2SQL_API_KEYS=key1,key2

# CORS origins for the web frontend (comma-separated)
# T2SQL_ALLOWED_ORIGINS=http://localhost:5173

# Rate limit per IP on /api/query
# T2SQL_RATE_LIMIT=10/minute
